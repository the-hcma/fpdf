[Unit]
Description=fpdf PDF filling server
After=network.target
StartLimitIntervalSec=100
StartLimitBurst=5

[Service]
Type=simple
# Assumes fpdf is located in ~/work/ai/fpdf
# Adjust the path below if your repository is in a different location
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@REPO_DIR@@/scripts/fpdf --yes --listen-all --port 8002
Restart=always
RestartSec=5
StandardOutput=append:%h/scratch/fpdf/fpdf.log
StandardError=append:%h/scratch/fpdf/fpdf.log
ExecStartPost=/usr/bin/curl --silent --fail --max-time 5 --retry 12 --retry-delay 1 --retry-connrefused http://127.0.0.1:8002/health

# Baseline hardening (fpdf#587). ``NoNewPrivileges`` is enforced everywhere. ``RestrictAddressFamilies`` is enforced
# on x86-64 and aarch64 but ignored on 32-bit x86, s390, mips and ppc ABIs, and it does not cover 32-bit calls on a
# host that also runs 32-bit x86 code, so it is paired with ``SystemCallArchitectures=native``. ``ProtectSystem``
# needs a mount namespace, which a user manager builds inside an unprivileged user namespace: where that is not
# allowed (``kernel.apparmor_restrict_unprivileged_userns=1``) systemd starts the unit without it and without an
# error, so it takes effect only on hosts that allow it. ``ProtectHome``, ``PrivateTmp`` and
# ``ProtectSystem=strict`` stay off on purpose: the server browses the home directory and saves next to the source
# PDF wherever the user chose, which can be /tmp. ``AF_NETLINK`` is the interface listing and ``ss`` (to find the
# process already holding the port); raw packet sockets are not used.
NoNewPrivileges=true
ProtectSystem=full
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=default.target
